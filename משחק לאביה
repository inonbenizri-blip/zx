<script>
const state = {
  stars: 0, gifts: [], muted: false, combo: 0,
  pendingMode: null, level: null, discoverIdx: 0,
};

const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");

const LETTER_DATA = {
  A: {heb:"איי",     word:"Apple",      he:"תפוח",       emoji:"🍎"},
  B: {heb:"בי",      word:"Ball",       he:"כדור",       emoji:"⚽"},
  C: {heb:"סי",      word:"Cat",        he:"חתול",       emoji:"🐱"},
  D: {heb:"די",      word:"Dog",        he:"כלב",        emoji:"🐶"},
  E: {heb:"אי",      word:"Egg",        he:"ביצה",       emoji:"🥚"},
  F: {heb:"אֶף",     word:"Fish",       he:"דג",         emoji:"🐟"},
  G: {heb:"ג'י",     word:"Giraffe",    he:"ג'ירפה",     emoji:"🦒"},
  H: {heb:"אייץ'",   word:"House",      he:"בית",        emoji:"🏠"},
  I: {heb:"איי",     word:"Ice cream",  he:"גלידה",      emoji:"🍦"},
  J: {heb:"ג'יי",    word:"Juice",      he:"מיץ",        emoji:"🧃"},
  K: {heb:"קיי",     word:"King",       he:"מלך",        emoji:"👑"},
  L: {heb:"אֵל",     word:"Lion",       he:"אריה",       emoji:"🦁"},
  M: {heb:"אֶם",     word:"Moon",       he:"ירח",        emoji:"🌙"},
  N: {heb:"אֵן",     word:"Nose",       he:"אף",         emoji:"👃"},
  O: {heb:"אוֹ",     word:"Orange",     he:"תפוז",       emoji:"🍊"},
  P: {heb:"פי",      word:"Pizza",      he:"פיצה",       emoji:"🍕"},
  Q: {heb:"קיוּ",    word:"Queen",      he:"מלכה",       emoji:"👸"},
  R: {heb:"אַר",     word:"Rainbow",    he:"קשת בענן",   emoji:"🌈"},
  S: {heb:"אֶס",     word:"Sun",        he:"שמש",        emoji:"☀️"},
  T: {heb:"טי",      word:"Tiger",      he:"נמר",        emoji:"🐯"},
  U: {heb:"יוּ",     word:"Umbrella",   he:"מטרייה",     emoji:"☂️"},
  V: {heb:"וי",      word:"Violin",     he:"כינור",      emoji:"🎻"},
  W: {heb:"דאבליו",  word:"Watermelon", he:"אבטיח",      emoji:"🍉"},
  X: {heb:"אֶקס",    word:"Box",        he:"קופסה",      emoji:"📦"},
  Y: {heb:"וואיי",   word:"Yo-yo",      he:"יויו",       emoji:"🪀"},
  Z: {heb:"זי",      word:"Zebra",      he:"זברה",       emoji:"🦓"}
};

const LEVELS = {
  starter: {name:"מתחילה", letters: "ABCDE".split("")},
  middle:  {name:"בינונית", letters: "ABCDEFGHIJ".split("")},
  expert:  {name:"אלופה",  letters: ALPHABET.slice()}
};

const GIFTS = [
  {emoji:"🦄", name:"חד-קרן קסום!"},{emoji:"🌸", name:"פרח ורוד"},
  {emoji:"🐱", name:"חתלתול חמוד"},{emoji:"🎀", name:"סרט נוצץ"},
  {emoji:"🍩", name:"דונאט מתוק"},{emoji:"🌈", name:"קשת בענן"},
  {emoji:"🦋", name:"פרפר זוהר"},{emoji:"🍓", name:"תות מתוק"},
  {emoji:"🐰", name:"ארנבון רך"},{emoji:"💎", name:"יהלום נדיר"},
  {emoji:"🐼", name:"פנדה חיבוקית"},{emoji:"🍭", name:"סוכרייה ענקית"},
  {emoji:"🐬", name:"דולפין שמח"},{emoji:"⭐", name:"כוכב על"},
  {emoji:"👑", name:"כתר מלכותי"},{emoji:"🦩", name:"פלמינגו ורוד"},
  {emoji:"🌟", name:"אבן חן זוהרת"},{emoji:"🐧", name:"פינגווין"},
  {emoji:"🍦", name:"גלידה גדולה"},{emoji:"🧁", name:"קאפקייק יפהפה"}
];

const POSITIVE = ["כל הכבוד אביה! ⭐","מעולה אביה! 🌟","וואו אביה! 💫","יופי אביה! ✨","מדהים! 🎉","סופר אביה! 💖","את אלופה אביה! 🏆"];
const TRY_AGAIN = ["נסי שוב אביה 💕","אופס... את יכולה!","כמעט אביה! ✨","עוד פעם 🌟","את קרובה 💖"];

function pick(a){ return a[Math.floor(Math.random()*a.length)]; }
function shuffle(a){ return a.map(v=>[Math.random(),v]).sort((x,y)=>x[0]-y[0]).map(v=>v[1]); }

function speak(text, opts={}){
  if(state.muted) return;
  if(!('speechSynthesis' in window)) return;
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(text);
  u.lang = opts.lang || 'en-US';
  u.rate = opts.rate || 0.8;
  u.pitch = opts.pitch || 1.15;
  const voices = speechSynthesis.getVoices();
  const eng = voices.find(v=>/en[-_]/i.test(v.lang));
  if(eng && u.lang.startsWith('en')) u.voice = eng;
  window.speechSynthesis.speak(u);
}
if('speechSynthesis' in window){ window.speechSynthesis.onvoiceschanged = ()=>{}; }

function showToast(msg, kind="good", ms=900){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show '+kind;
  clearTimeout(t._t);
  t._t = setTimeout(()=>{ t.className = 'toast '+kind; }, ms);
}

function confettiBurst(count=40){
  const host = document.getElementById('confetti');
  const colors = ['#ff7eb6','#b78aff','#7ee5c1','#ffd95a','#ff9a55','#7ec9ff'];
  for(let i=0;i<count;i++){
    const s = document.createElement('span');
    s.style.left = Math.random()*100+'vw';
    s.style.background = pick(colors);
    s.style.animationDelay = (Math.random()*0.4)+'s';
    s.style.animationDuration = (1.2 + Math.random()*1.4)+'s';
    s.style.borderRadius = Math.random()>.5 ? '50%' : '2px';
    s.style.transform = `rotate(${Math.random()*360}deg)`;
    host.appendChild(s);
    setTimeout(()=> s.remove(), 2800);
  }
}

function updateStats(){
  document.getElementById('starCount').textContent = state.stars;
  document.getElementById('giftCount').textContent = state.gifts.length;
}
function awardStar(){
  state.stars++;
  updateStats();
  const target = state.gifts.length;
  if(state.stars >= (target+1)*5 && target < GIFTS.length){
    const gift = GIFTS[target];
    state.gifts.push(target);
    updateStats();
    setTimeout(()=> openGiftModal(gift), 600);
  }
}
function openGiftModal(g){
  document.getElementById('giftEmoji').textContent = g.emoji;
  document.getElementById('giftName').textContent = "זכית ב"+g.name;
  document.getElementById('giftModal').classList.add('active');
  confettiBurst(80);
}
document.getElementById('giftClose').onclick = ()=>{
  document.getElementById('giftModal').classList.remove('active');
};

function go(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById('screen-'+id).classList.add('active');
}

document.getElementById('homeBtn').onclick = ()=>{
  window.speechSynthesis && window.speechSynthesis.cancel();
  go('home');
};

document.querySelectorAll('.mode-card').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    const m = btn.dataset.mode;
    if(m==='discover') startDiscover();
    else if(m==='gifts') openGiftRoom();
    else { state.pendingMode = m; openLevelSelect(m); }
  });
});

document.getElementById('muteBtn').onclick = ()=>{
  state.muted = !state.muted;
  document.getElementById('muteBtn').style.opacity = state.muted ? .45 : 1;
  if(state.muted) window.speechSynthesis && window.speechSynthesis.cancel();
};

function openLevelSelect(mode){
  const titles = {
    hunt:"צייד האותיות 🔎",
    memory:"זיכרון אותיות 🧠",
    order:"סדר האלפבית 🪜"
  };
  document.getElementById('levelTitle').textContent = titles[mode] || "בחרי רמה";
  go('level');
}
document.querySelectorAll('.level-card').forEach(c=>{
  c.addEventListener('click', ()=>{
    state.level = c.dataset.level;
    const m = state.pendingMode;
    if(m==='hunt') startHunt();
    else if(m==='memory') startMemory();
    else if(m==='order') startOrder();
  });
});

function startDiscover(){
  state.discoverIdx = 0;
  go('discover');
  showLetter(0);
}
function showLetter(idx){
  state.discoverIdx = idx;
  const L = ALPHABET[idx];
  const D = LETTER_DATA[L];
  document.getElementById('dUpper').textContent = L;
  document.getElementById('dLower').textContent = L.toLowerCase();
  document.getElementById('dHeb').textContent = D.heb;
  document.getElementById('dEmoji').textContent = D.emoji;
  document.getElementById('dWord').textContent = D.word;
  document.getElementById('dWordHe').textContent = D.he;
  document.getElementById('dPos').textContent = `אות ${idx+1} מתוך 26`;

  const pair = document.querySelector('.letter-pair');
  pair.style.animation='none'; void pair.offsetWidth; pair.style.animation='';
  const emoji = document.getElementById('dEmoji');
  emoji.style.animation='none'; void emoji.offsetWidth; emoji.style.animation='';

  document.getElementById('dPrev').disabled = idx===0;
  document.getElementById('dNext').textContent = idx===25 ? "סיימתי 🎉" : "אות הבאה ←";

  setTimeout(()=> speak(L), 200);
}
document.getElementById('dPrev').onclick = ()=>{
  if(state.discoverIdx>0) showLetter(state.discoverIdx-1);
};
document.getElementById('dNext').onclick = ()=>{
  if(state.discoverIdx<25) {
    awardStar();
    showLetter(state.discoverIdx+1);
  } else {
    awardStar();
    confettiBurst(120);
    showToast("סיימת את כל ה-26! 🏆","good",2000);
    setTimeout(()=> go('home'), 2200);
  }
};
document.getElementById('dSpeak').onclick = ()=>{
  const L = ALPHABET[state.discoverIdx];
  const D = LETTER_DATA[L];
  speak(L);
  setTimeout(()=> speak(D.word, {rate:0.85}), 800);
};

let huntCurrent = null;
let huntRound = 0;
const HUNT_ROUNDS = 8;

function startHunt(){
  huntRound = 0;
  state.combo = 0;
  document.getElementById('huntHebHint').classList.remove('show');
  go('hunt');
  nextHunt();
}

function nextHunt(){
  huntRound++;
  if(huntRound > HUNT_ROUNDS){
    showToast("סיימת סבב, אביה! 🎉","good", 1500);
    confettiBurst(60);
    setTimeout(()=> startHunt(), 1700);
    return;
  }
  document.getElementById('huntProgress').style.width = ((huntRound-1)/HUNT_ROUNDS*100)+'%';
  document.getElementById('huntHebHint').classList.remove('show');

  const pool = LEVELS[state.level].letters;
  huntCurrent = pick(pool);

  const numOpts = Math.min(3, pool.length);
  const others = shuffle(pool.filter(l=>l!==huntCurrent)).slice(0, numOpts-1);
  const choices = shuffle([huntCurrent, ...others]);

  const wrap = document.getElementById('huntOptions');
  wrap.innerHTML = '';
  choices.forEach(letter=>{
    const b = document.createElement('button');
    b.className = 'opt';
    b.textContent = letter;
    b.addEventListener('click', ()=> handleHuntPick(b, letter));
    wrap.appendChild(b);
  });

  setTimeout(()=> speak(huntCurrent), 250);
}

function handleHuntPick(btn, letter){
  const correct = letter === huntCurrent;
  document.querySelectorAll('#huntOptions .opt').forEach(o=>o.classList.add('disabled'));
  const hint = document.getElementById('huntHebHint');
  hint.textContent = `${huntCurrent} = ${LETTER_DATA[huntCurrent].heb}`;
  hint.classList.add('show');

  if(correct){
    btn.classList.add('correct');
    state.combo++;
    awardStar();
    if(state.combo >= 3){
      awardStar();
      showToast("שרשרת! +1 ⭐","good", 1100);
      state.combo = 0;
    } else {
      showToast(pick(POSITIVE),"good", 800);
    }
    speak(huntCurrent, {rate:0.95});
    setTimeout(nextHunt, 1300);
  } else {
    btn.classList.add('wrong');
    state.combo = 0;
    document.querySelectorAll('#huntOptions .opt').forEach(o=>{
      if(o.textContent === huntCurrent) o.classList.add('correct');
    });
    showToast(pick(TRY_AGAIN),"bad", 1100);
    setTimeout(nextHunt, 1700);
  }
  document.getElementById('huntProgress').style.width = (huntRound/HUNT_ROUNDS*100)+'%';
}

document.getElementById('huntSpeak').onclick = ()=>{
  if(huntCurrent) speak(huntCurrent);
};

let memOpen = [];
let memBusy = false;
let memMatched = 0;
let memTotal = 0;

function startMemory(){
  go('memory');
  const pool = LEVELS[state.level].letters;
  const pairCount = state.level==='starter' ? 4 : (state.level==='middle' ? 6 : 8);
  const chosen = shuffle(pool.slice()).slice(0, Math.min(pairCount, pool.length));
  const cards = [];
  chosen.forEach(L=>{
    cards.push({key:L, label:L, isUpper:true});
    cards.push({key:L, label:L.toLowerCase(), isUpper:false});
  });
  const arranged = shuffle(cards);
  memOpen = []; memBusy = false; memMatched = 0; memTotal = chosen.length;

  const grid = document.getElementById('memoryGrid');
  grid.innerHTML = '';
  arranged.forEach((c,i)=>{
    const el = document.createElement('div');
    el.className = 'card';
    el.dataset.key = c.key;
    el.dataset.isUpper = c.isUpper;
    el.innerHTML = `
      <div class="card-inner">
        <div class="card-face card-front">?</div>
        <div class="card-face card-back">${c.label}</div>
      </div>`;
    el.addEventListener('click', ()=> flipCard(el));
    grid.appendChild(el);
  });
}

function flipCard(el){
  if(memBusy) return;
  if(el.classList.contains('flipped') || el.classList.contains('matched')) return;
  el.classList.add('flipped');
  speak(el.dataset.key);
  memOpen.push(el);
  if(memOpen.length === 2){
    memBusy = true;
    const [a,b] = memOpen;
    if(a.dataset.key === b.dataset.key && a.dataset.isUpper !== b.dataset.isUpper){
      setTimeout(()=>{
        a.classList.add('matched'); b.classList.add('matched');
        memOpen = []; memBusy = false;
        memMatched++;
        awardStar();
        showToast(pick(POSITIVE),"good",700);
        if(memMatched === memTotal){
          confettiBurst(80);
          showToast("ניצחת אביה! 🏆","good",1700);
          setTimeout(startMemory, 2000);
        }
      }, 350);
    } else {
      setTimeout(()=>{
        a.classList.remove('flipped');
        b.classList.remove('flipped');
        memOpen = []; memBusy = false;
      }, 900);
    }
  }
}

let orderTarget = [];
let orderFilled = [];

function startOrder(){
  go('order');
  const pool = LEVELS[state.level].letters;
  const len = state.level==='starter' ? 3 : (state.level==='middle' ? 4 : 5);
  const maxStart = Math.max(0, pool.length - len);
  const start = Math.floor(Math.random() * (maxStart + 1));
  orderTarget = pool.slice(start, start + len);
  orderFilled = new Array(orderTarget.length).fill(null);

  const slots = document.getElementById('orderSlots');
  slots.innerHTML = '';
  orderTarget.forEach((_,i)=>{
    const s = document.createElement('div');
    s.className = 'order-slot';
    s.dataset.idx = i;
    slots.appendChild(s);
  });

  const pPool = document.getElementById('orderPool');
  pPool.innerHTML = '';
  shuffle(orderTarget.slice()).forEach(letter=>{
    const b = document.createElement('button');
    b.className = 'pool-letter';
    b.textContent = letter;
    b.addEventListener('click', ()=> placeLetter(b, letter));
    pPool.appendChild(b);
  });
}

function placeLetter(btn, letter){
  const idx = orderFilled.findIndex(v=>v===null);
  if(idx === -1) return;
  const slot = document.querySelector(`#orderSlots .order-slot[data-idx="${idx}"]`);

  if(orderTarget[idx] === letter){
    slot.textContent = letter;
    slot.classList.add('filled');
    orderFilled[idx] = letter;
    btn.classList.add('used');
    speak(letter);
    awardStar();
    showToast(pick(POSITIVE),"good",700);

    if(orderFilled.every(v=>v!==null)){
      confettiBurst(80);
      showToast("מושלם, אביה! 🌈","good",1700);
      setTimeout(startOrder, 2000);
    }
  } else {
    btn.animate([
      {transform:'translateX(0)'},{transform:'translateX(-8px)'},
      {transform:'translateX(8px)'},{transform:'translateX(0)'}
    ], {duration:350});
    showToast("האות הזו לא הבאה בסדר 💕","bad",1100);
    speak(orderTarget[idx]);
  }
}

document.getElementById('orderClear').onclick = startOrder;

function openGiftRoom(){
  go('gifts');
  const grid = document.getElementById('giftGrid');
  grid.innerHTML = '';
  GIFTS.forEach((g,i)=>{
    const slot = document.createElement('div');
    const unlocked = state.gifts.includes(i);
    slot.className = 'gift-slot ' + (unlocked ? 'unlocked' : 'locked');
    slot.textContent = unlocked ? g.emoji : '🔒';
    slot.title = unlocked ? g.name : 'מתנה נעולה';
    if(unlocked){
      slot.addEventListener('click', ()=>{
        showToast(g.name, "good", 1000);
        slot.style.transform = 'scale(1.2) rotate(8deg)';
        setTimeout(()=> slot.style.transform = '', 350);
      });
    }
    grid.appendChild(slot);
  });
  const left = Math.max(0, ((state.gifts.length+1)*5) - state.stars);
  document.getElementById('giftsLine').textContent =
    state.gifts.length === GIFTS.length
      ? "אביה, אספת את כל המתנות! 🏆"
      : `עוד ${left} כוכבים למתנה הבאה!`;
}

updateStats();
</script>
