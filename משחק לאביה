<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ההרפתקה של אביה 💖 ABC</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Varela+Round&family=Bagel+Fat+One&display=swap" rel="stylesheet">
<style>
  :root{
    --pink:#ff7eb6; --pink-soft:#ffd6e8; --purple:#b78aff;
    --mint:#7ee5c1; --yellow:#ffd95a; --orange:#ff9a55;
    --sky:#7ec9ff; --cream:#fff5e6; --dark:#3a2a55;
    --shadow: 0 8px 0 rgba(0,0,0,0.08), 0 14px 30px rgba(123, 67, 151, 0.2);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;}
  body{
    font-family:'Varela Round','Fredoka',sans-serif;
    color:var(--dark);
    background: linear-gradient(135deg, #ffe6f0 0%, #e8e1ff 50%, #d6f5ff 100%);
    min-height:100vh;overflow-x:hidden;user-select:none;
    -webkit-tap-highlight-color: transparent;
  }
  body::before, body::after{
    content:'';position:fixed;border-radius:50%;
    filter:blur(40px);opacity:.6;z-index:0;pointer-events:none;
  }
  body::before{
    width:340px;height:340px;background:var(--pink-soft);
    top:-80px;right:-80px;animation: float1 14s ease-in-out infinite;
  }
  body::after{
    width:300px;height:300px;background:#cdeffd;
    bottom:-60px;left:-60px;animation: float2 16s ease-in-out infinite;
  }
  @keyframes float1 {
    0%,100%{transform: translate(0,0) scale(1);}
    50%{transform: translate(-30px,40px) scale(1.1);}
  }
  @keyframes float2 {
    0%,100%{transform: translate(0,0) scale(1);}
    50%{transform: translate(40px,-30px) scale(1.15);}
  }

  .app{
    position:relative;z-index:1;max-width:760px;
    margin:0 auto;padding:18px 16px 60px;min-height:100vh;
  }

  .topbar{
    display:flex;align-items:center;justify-content:space-between;
    background: rgba(255,255,255,0.7);backdrop-filter: blur(10px);
    border-radius:24px;padding:10px 16px;
    box-shadow: var(--shadow);margin-bottom:18px;
  }
  .stats{display:flex;gap:10px;align-items:center;flex-wrap:wrap;}
  .pill{
    display:inline-flex;align-items:center;gap:6px;
    background:#fff;padding:8px 14px;border-radius:999px;
    font-weight:700;font-size:16px;
    box-shadow: 0 3px 0 rgba(0,0,0,0.06);
  }
  .pill.stars{color:#e89a00;}
  .pill.gifts{color:#b67dff;}
  .pill svg{width:20px;height:20px;}

  .home-btn, .icon-btn{
    background:#fff;border:none;cursor:pointer;
    width:42px;height:42px;border-radius:50%;
    display:grid;place-items:center;
    box-shadow: 0 3px 0 rgba(0,0,0,0.06);
    transition: transform .15s;color:var(--dark);
  }
  .home-btn:hover, .icon-btn:hover{transform: translateY(-2px) scale(1.06);}
  .icon-btn svg{width:22px;height:22px;}

  .screen{display:none; animation: pop .35s cubic-bezier(.2,1.4,.4,1);}
  .screen.active{display:block;}
  @keyframes pop {
    0%{opacity:0;transform: translateY(10px) scale(.97);}
    100%{opacity:1;transform: translateY(0) scale(1);}
  }

  .welcome{text-align:center;padding-top:8px;}
  .name-banner{
    display:inline-flex;align-items:center;gap:10px;
    background: linear-gradient(135deg,#fff 0%, #ffe6f0 100%);
    padding:8px 20px;border-radius:999px;
    box-shadow: 0 5px 0 rgba(255,126,182,.25), 0 10px 24px rgba(123,67,151,.15);
    border:3px solid #fff;margin-bottom:14px;
    font-family:'Fredoka',sans-serif;font-weight:700;
    font-size:18px;color:var(--purple);
    animation: tilt-bob 3s ease-in-out infinite;
  }
  .name-banner-text{
    background: linear-gradient(135deg,var(--pink),var(--purple));
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;
    background-clip:text;font-size:22px;letter-spacing:.5px;
  }
  .name-banner-emoji{font-size:22px;animation: wiggle 2.5s ease-in-out infinite;}
  .name-banner-emoji:last-child{animation-delay:.3s;}
  @keyframes tilt-bob {
    0%,100%{transform: translateY(0) rotate(-1deg);}
    50%{transform: translateY(-3px) rotate(1deg);}
  }
  @keyframes wiggle {
    0%,100%{transform: rotate(-8deg);} 50%{transform: rotate(8deg);}
  }
  .title{
    font-family:'Fredoka', sans-serif;font-weight:700;
    font-size:clamp(40px, 9vw, 60px);color:var(--pink);
    text-shadow: 0 4px 0 #fff, 0 8px 0 rgba(255,126,182,.25);
    line-height:1;margin-bottom:6px;letter-spacing:1px;
  }
  .title .sparkle{display:inline-block;animation: spin 4s linear infinite;}
  @keyframes spin {to{transform: rotate(360deg);}}
  .subtitle{
    font-family:'Fredoka',sans-serif;font-weight:600;
    font-size:18px;color:var(--dark);margin-bottom:18px;
  }
  .mascot{
    width:160px;height:160px;margin:6px auto 14px;
    animation: bounce 2.6s ease-in-out infinite;
    filter: drop-shadow(0 14px 14px rgba(123,67,151,0.18));
  }
  @keyframes bounce {
    0%,100%{transform: translateY(0) rotate(-2deg);}
    50%{transform: translateY(-12px) rotate(2deg);}
  }

  .modes{display:grid;grid-template-columns: 1fr;gap:14px;margin-top:6px;}
  @media (min-width:560px){.modes{grid-template-columns: 1fr 1fr;}}
  .mode-card{
    background:#fff;border-radius:24px;padding:18px 16px;
    text-align:right;cursor:pointer;border:none;font-family:inherit;
    box-shadow: var(--shadow);transition: transform .2s;
    display:flex;align-items:center;gap:14px;
    position:relative;overflow:hidden;
  }
  .mode-card:hover{transform: translateY(-4px);}
  .mode-card:active{transform: translateY(0);}
  .mode-card .emoji{
    font-size:46px;flex-shrink:0;
    width:64px;height:64px;display:grid;place-items:center;
    border-radius:18px;background: var(--bg, var(--pink-soft));
  }
  .mode-card .info h3{
    font-family:'Fredoka',sans-serif;
    font-size:21px;font-weight:700;margin-bottom:2px;
  }
  .mode-card .info p{font-size:14px;color:#7a6a8e;}
  .mode-card.featured{
    background: linear-gradient(135deg, #fff 0%, #fff5e6 100%);
    border:3px solid #ffd95a;grid-column: 1 / -1;
  }
  .mode-card.featured::after{
    content:'התחילי כאן 👇';position:absolute;top:8px;left:8px;
    background: var(--yellow);color:var(--dark);
    padding:3px 10px;border-radius:999px;
    font-size:11px;font-weight:700;
  }
  .mode-card.gift-room{
    background: linear-gradient(135deg, #fff4d4, #ffd6e8);grid-column: 1 / -1;
  }

  .board{
    background: rgba(255,255,255,0.85);
    border-radius:30px;padding:18px 16px 24px;
    box-shadow: var(--shadow);text-align:center;
    backdrop-filter: blur(8px);
  }
  .progress-wrap{
    height:14px;background:#f0e8fa;border-radius:999px;
    overflow:hidden;margin:6px 6px 18px;
  }
  .progress-bar{
    height:100%;width:0%;
    background: linear-gradient(90deg, var(--pink), var(--purple));
    border-radius:999px;transition: width .5s cubic-bezier(.2,1.4,.4,1);
  }
  .question{
    font-family:'Fredoka',sans-serif;font-weight:600;
    font-size:20px;margin-bottom:10px;
  }
  .speak-btn{
    background:linear-gradient(135deg,var(--purple),var(--pink));
    color:#fff;border:none;cursor:pointer;
    padding:14px 26px;border-radius:999px;
    font-family:inherit;font-size:18px;font-weight:700;
    box-shadow: 0 5px 0 rgba(0,0,0,0.12);
    display:inline-flex;align-items:center;gap:8px;
    transition: transform .15s;margin-bottom:8px;
  }
  .speak-btn:hover{transform: translateY(-2px);}
  .speak-btn:active{transform: translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,0.12);}
  .speak-btn svg{width:22px;height:22px;}

  .level-grid{
    display:grid;grid-template-columns: 1fr;
    gap:14px;margin-top:18px;max-width:500px;margin-inline:auto;
  }
  .level-card{
    background:#fff;border:none;cursor:pointer;
    border-radius:22px;padding:18px;
    display:flex;align-items:center;gap:14px;
    text-align:right;font-family:inherit;
    box-shadow: var(--shadow);transition: transform .2s;
    border-right:6px solid var(--c, var(--mint));
  }
  .level-card:hover{transform: translateY(-3px);}
  .level-card .lv-emoji{
    font-size:42px;width:60px;height:60px;
    border-radius:18px;display:grid;place-items:center;
    background: var(--bg, #dff7ec);flex-shrink:0;
  }
  .level-card h3{
    font-family:'Fredoka',sans-serif;font-size:20px;
    font-weight:700;margin-bottom:2px;
  }
  .level-card p{font-size:14px;color:#7a6a8e;}

  .discover-card{
    background: #fff;border-radius:30px;
    padding:22px 16px 18px;text-align:center;
    box-shadow: var(--shadow);position:relative;overflow:hidden;
  }
  .discover-position{
    background: rgba(183,138,255,0.12);color:var(--purple);
    display:inline-block;padding:5px 14px;border-radius:999px;
    font-weight:700;font-size:14px;margin-bottom:8px;
  }
  .letter-pair{
    display:flex;align-items:flex-end;justify-content:center;
    gap:14px;line-height:1;margin:6px 0;
    animation: letter-in .4s cubic-bezier(.2,1.4,.4,1);
  }
  .letter-upper{
    font-family:'Fredoka', sans-serif;font-weight:700;
    font-size:120px;color:var(--purple);
    text-shadow: 0 6px 0 #fff, 0 12px 0 rgba(183,138,255,0.25);
  }
  .letter-lower{
    font-family:'Fredoka', sans-serif;font-weight:700;
    font-size:84px;color:var(--pink);
    text-shadow: 0 5px 0 #fff, 0 10px 0 rgba(255,126,182,0.25);
  }
  @keyframes letter-in {
    0%{transform: scale(.5) rotate(-12deg); opacity:0;}
    100%{transform: scale(1) rotate(0); opacity:1;}
  }
  .heb-name{
    font-family:'Fredoka',sans-serif;font-weight:700;
    font-size:30px;color:var(--dark);
    background: var(--yellow);display:inline-block;
    padding:6px 22px;border-radius:999px;
    box-shadow: 0 4px 0 rgba(0,0,0,0.08);margin:8px 0;
  }
  .word-card{
    margin:14px auto 4px;background: linear-gradient(135deg,#fff5e6,#ffe6f0);
    border-radius:24px;padding:14px 12px;max-width:340px;
    box-shadow: 0 4px 0 rgba(0,0,0,0.05);
  }
  .word-emoji{
    font-size:80px;display:block;line-height:1;margin:4px 0;
    animation: wordpop .5s cubic-bezier(.2,1.6,.4,1);
  }
  @keyframes wordpop {
    0%{transform:scale(0) rotate(-20deg);}
    100%{transform:scale(1) rotate(0);}
  }
  .word-en{
    font-family:'Fredoka', sans-serif;font-weight:700;
    font-size:32px;color:var(--purple);margin:2px 0;
  }
  .word-he{
    font-family:'Fredoka',sans-serif;font-weight:600;
    font-size:20px;color:#7a6a8e;
  }
  .nav-row{
    display:flex;gap:10px;justify-content:center;
    margin-top:14px;flex-wrap:wrap;
  }
  .nav-btn{
    background:#fff;border:none;cursor:pointer;
    padding:12px 22px;border-radius:999px;
    font-family:'Fredoka',sans-serif;font-size:17px;font-weight:700;
    box-shadow: 0 4px 0 rgba(0,0,0,0.08);color:var(--dark);
    transition: transform .15s;
  }
  .nav-btn:hover{transform: translateY(-2px);}
  .nav-btn:active{transform: translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,0.08);}
  .nav-btn:disabled{opacity:.4;cursor:not-allowed;}
  .nav-btn.primary{
    background: linear-gradient(135deg, var(--mint), var(--sky));color:#fff;
  }

  .options{
    display:grid;grid-template-columns: 1fr 1fr 1fr;
    gap:10px;margin-top:14px;
  }
  .opt{
    background:#fff;border:4px solid transparent;border-radius:22px;
    padding:18px 6px;font-family:'Fredoka', sans-serif;font-weight:700;
    font-size:48px;color:var(--dark);cursor:pointer;
    box-shadow: 0 5px 0 rgba(0,0,0,0.07);
    transition: transform .15s, border-color .15s, background .2s;
    line-height:1;
  }
  .opt:hover{transform: translateY(-3px);}
  .opt:active{transform: translateY(2px);}
  .opt.correct{
    background:linear-gradient(135deg,#a4f3c8,#7ee5c1);
    border-color:#3ec18b;color:#1d6b46;animation: pulse-good .5s;
  }
  .opt.wrong{
    background:#ffd0d0;border-color:#ff6b6b;color:#c93838;
    animation: shake .4s;
  }
  .opt.disabled{pointer-events:none;opacity:.85;}
  @keyframes shake {
    0%,100%{transform: translateX(0);}
    25%{transform: translateX(-8px);}75%{transform: translateX(8px);}
  }
  @keyframes pulse-good {
    0%{transform: scale(1);}50%{transform: scale(1.08);}100%{transform: scale(1);}
  }
  .heb-hint{
    display:inline-block;background:#fff;
    padding:8px 18px;border-radius:999px;
    font-weight:700;font-size:18px;color:var(--purple);
    margin:6px 0;box-shadow: 0 3px 0 rgba(0,0,0,0.06);
    opacity:0;transition: opacity .3s;
  }
  .heb-hint.show{opacity:1;}

  .memory-grid{display:grid;gap:10px;margin-top:10px;grid-template-columns: repeat(4, 1fr);}
  .card{aspect-ratio: 1;perspective:800px;cursor:pointer;}
  .card-inner{
    position:relative;width:100%;height:100%;
    transform-style:preserve-3d;transition: transform .5s;
  }
  .card.flipped .card-inner, .card.matched .card-inner{transform: rotateY(180deg);}
  .card-face{
    position:absolute;inset:0;border-radius:18px;
    display:grid;place-items:center;backface-visibility:hidden;
    box-shadow: 0 4px 0 rgba(0,0,0,0.08);
    font-family:'Fredoka', sans-serif;font-weight:700;font-size:38px;
  }
  .card-front{
    background: linear-gradient(135deg,var(--pink),var(--purple));
    color:#fff;font-size:30px;font-family:'Fredoka',sans-serif;
  }
  .card-back{background:#fff;transform: rotateY(180deg);color:var(--purple);}
  .card.matched .card-back{
    background: linear-gradient(135deg,#a4f3c8,#7ee5c1);
    color:#1d6b46;animation: pulse-good .5s;
  }

  .order-track{
    display:flex;flex-wrap:wrap;gap:8px;
    justify-content:center;margin-top:10px;
  }
  .order-slot{
    width:64px;height:64px;border:3px dashed #c8b8e0;
    border-radius:16px;background: rgba(255,255,255,.5);
    display:grid;place-items:center;
    font-family:'Fredoka', sans-serif;font-weight:700;font-size:36px;color:var(--purple);
  }
  .order-slot.filled{
    border-style:solid;background:#fff;border-color:var(--purple);
  }
  .order-pool{
    display:flex;flex-wrap:wrap;gap:8px;justify-content:center;
    margin-top:14px;min-height:64px;
  }
  .pool-letter{
    width:64px;height:64px;
    background:linear-gradient(135deg,var(--yellow),var(--orange));
    border-radius:16px;display:grid;place-items:center;
    font-family:'Fredoka', sans-serif;font-weight:700;font-size:36px;color:#fff;
    cursor:pointer;box-shadow: 0 4px 0 rgba(0,0,0,0.1);
    transition: transform .15s;border:none;
    text-shadow: 0 2px 0 rgba(0,0,0,0.15);
  }
  .pool-letter:hover{transform: translateY(-3px) scale(1.05);}
  .pool-letter.used{opacity:.3;pointer-events:none;}

  .toast{
    position:fixed;top:50%; left:50%;
    transform: translate(-50%,-50%) scale(.5);background:#fff;
    padding:24px 36px;border-radius:30px;
    font-family:'Fredoka',sans-serif;font-size:28px;font-weight:700;
    box-shadow: 0 12px 40px rgba(0,0,0,.2);
    pointer-events:none;opacity:0;
    transition: all .3s cubic-bezier(.2,1.4,.4,1);
    z-index:1000;text-align:center;
  }
  .toast.show{opacity:1;transform: translate(-50%,-50%) scale(1);}
  .toast.good{color:#3ec18b;}
  .toast.bad{color:#e74c3c;}

  .modal{
    position:fixed;inset:0;background: rgba(40,20,60,0.5);
    backdrop-filter: blur(6px);display:none;
    align-items:center;justify-content:center;z-index:2000;padding:20px;
  }
  .modal.active{display:flex; animation: fadeIn .3s;}
  @keyframes fadeIn {from{opacity:0;}to{opacity:1;}}
  .modal-card{
    background: linear-gradient(135deg,#fff5e6,#ffe6f0);
    padding:32px 28px;border-radius:34px;text-align:center;
    max-width:380px;width:100%;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    animation: popIn .5s cubic-bezier(.2,1.6,.4,1);
    position:relative;overflow:hidden;
  }
  @keyframes popIn {
    0%{transform: scale(.5) rotate(-10deg);opacity:0;}
    100%{transform: scale(1) rotate(0);opacity:1;}
  }
  .modal-card h2{
    font-family:'Fredoka', sans-serif;font-weight:700;
    font-size:30px;color:var(--pink);
    margin-bottom:8px;text-shadow: 0 3px 0 #fff;
  }
  .modal-card p{font-size:18px; margin-bottom:14px; color:#6b5685;}
  .gift-emoji{
    font-size:96px;display:block;margin:8px auto 14px;
    animation: spin-pop 1.2s ease-out;
    filter: drop-shadow(0 8px 12px rgba(0,0,0,0.15));
  }
  @keyframes spin-pop {
    0%{transform: scale(0) rotate(-180deg);}
    60%{transform: scale(1.2) rotate(20deg);}
    100%{transform: scale(1) rotate(0);}
  }
  .btn-primary{
    background:linear-gradient(135deg,var(--pink),var(--purple));
    color:#fff;border:none;cursor:pointer;
    padding:14px 30px;border-radius:999px;
    font-family:'Fredoka',sans-serif;font-size:18px;font-weight:700;
    box-shadow: 0 5px 0 rgba(0,0,0,0.15);transition: transform .15s;
  }
  .btn-primary:hover{transform: translateY(-2px);}
  .btn-primary:active{transform: translateY(2px); box-shadow: 0 1px 0 rgba(0,0,0,0.15);}

  .gift-grid{
    display:grid;grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    gap:12px;margin-top:10px;
  }
  .gift-slot{
    aspect-ratio:1;border-radius:20px;background: rgba(255,255,255,.6);
    display:grid;place-items:center;font-size:42px;
    border:3px solid transparent;transition: transform .2s;
  }
  .gift-slot.unlocked{
    background:#fff;border-color:var(--pink);
    box-shadow: 0 4px 0 rgba(0,0,0,0.06);
  }
  .gift-slot.unlocked:hover{transform: scale(1.1) rotate(5deg);}
  .gift-slot.locked{color:#c8b8e0;font-size:28px;}

  .confetti{position:fixed;pointer-events:none;z-index:1500;inset:0;overflow:hidden;}
  .confetti span{
    position:absolute;width:10px;height:14px;top:-20px;
    animation: fall 1.6s linear forwards;
  }
  @keyframes fall {to{transform: translateY(110vh) rotate(720deg); opacity: 0;}}

  .ghost-btn{
    background: rgba(255,255,255,0.8);color: var(--dark);
    border:none;cursor:pointer;padding:12px 22px;border-radius:999px;
    font-family:'Fredoka',sans-serif;font-size:16px;font-weight:700;
    box-shadow: 0 3px 0 rgba(0,0,0,0.06);transition: transform .15s;
  }
  .ghost-btn:hover{transform: translateY(-2px);}
  .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:14px;}
  .screen-title{
    font-family:'Fredoka', sans-serif;font-weight:700;font-size:30px;
    color:var(--pink);text-shadow: 0 3px 0 #fff;
    margin-bottom:6px;text-align:center;
  }
  .screen-subtitle{text-align:center;color:#7a6a8e;font-size:16px;margin-bottom:6px;}
</style>
</head>
<body>
<div class="app">

  <div class="topbar">
    <button class="home-btn" id="homeBtn" aria-label="חזרה הביתה" title="בית">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 11.5L12 4l9 7.5"/><path d="M5 10v10h14V10"/>
      </svg>
    </button>
    <div class="stats">
      <div class="pill stars">
        <svg viewBox="0 0 24 24" fill="#ffc94d"><path d="M12 2l3 7 7 .8-5.3 4.7L18 22l-6-3.6L6 22l1.3-7.5L2 9.8 9 9z"/></svg>
        <span id="starCount">0</span>
      </div>
      <div class="pill gifts">
        <svg viewBox="0 0 24 24" fill="#b78aff"><path d="M20 7h-3.6a3 3 0 0 0-4.4-3.6A3 3 0 0 0 7.6 7H4v4h2v10h12V11h2zM12 6.5a1 1 0 1 1 1 1h-1zm-1 1h-1a1 1 0 1 1 1-1zM8 11h3v9H8zm5 9v-9h3v9z"/></svg>
        <span id="giftCount">0</span>
      </div>
    </div>
    <button class="icon-btn" id="muteBtn" aria-label="קול" title="הפעל/השתק קול">
